---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="contact" id="contact">
  <div class="wrap">
    <h2 class="contact__heading">Let's work together</h2>
    <p class="contact__lead">Hiring a developer, or have a project in mind? Send me an email and I will get back to you.</p>

    <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>

    <div class="contact__email">
      <button type="button" data-copy={site.email} aria-live="polite">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
          <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>

    <ul class="contact__links">
      <li><a href={site.cv} download={site.cvFileName}>Download CV</a></li>
      <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    </ul>

    <div class="edge contact__end">
      <span>Thibo Vonderlynck &copy; {year}</span>
      <a href="#top">Back to top</a>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector('[data-copy-label]');
    button.addEventListener('click', async () => {
      if (!label) return;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed, select the address instead';
      }
      setTimeout(() => (label.textContent = 'Copy'), 2000);
    });
  });
</script>

<style>
  /* The light table is switched off for the close. */
  .contact {
    margin-top: clamp(5rem, 11vw, 9rem);
    padding-block: clamp(4.5rem, 10vw, 8rem) 2rem;
    background: var(--film);
    color: var(--table);
  }

  .contact ::selection {
    background: var(--edge);
    color: var(--film);
  }

  .contact :focus-visible {
    outline-color: var(--edge);
  }

  .contact__heading {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #b4c0c5;
  }

  .contact__lead {
    max-width: 34rem;
    margin-top: 0.75rem;
    color: #8d999e;
  }

  /* The address is the one lit thing in the room. */
  .contact__address {
    display: block;
    width: fit-content;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    font-stretch: 75%;
    font-weight: 700;
    font-size: min(7.4vw, 6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-decoration: none;
    color: #fff;
    transition: color 0.2s;
  }

  .contact__address:hover {
    color: var(--edge);
  }

  .contact__email {
    display: flex;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-bottom: 1.75rem;
    border-bottom: 1px solid #34383b;
  }

  .contact__email button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border: 1.5px solid var(--edge);
    border-radius: 3px;
    background: none;
    color: var(--edge);
    font-weight: 600;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .contact__email button:hover {
    background: var(--edge);
    color: var(--film);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin-top: 1.75rem;
  }

  .contact__links a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--edge);
  }

  .contact__links a:hover {
    color: var(--edge);
  }

  .contact__end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(4rem, 9vw, 7rem);
    color: #8d999e;
  }

  .contact__end a:hover {
    color: var(--edge);
  }
</style>
