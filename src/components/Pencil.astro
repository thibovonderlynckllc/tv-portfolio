const { kind } = Astro.props;
const mark = marks[kind];
const maskId = `pencil-${kind}`;
---

<svg class:list={['pencil', `pencil--${kind}`]} viewBox={mark.viewBox} preserveAspectRatio="none" aria-hidden="true">
  <mask id={maskId} maskUnits="userSpaceOnUse">
    <path class="pencil__reveal" d={mark.centre} pathLength="1" stroke-width={mark.width} />
  </mask>
  <path class="pencil__wax" d={mark.outline} mask={`url(#${maskId})`} />
</svg>

<style>
  .pencil {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .pencil--box {
    inset: -5% -2%;
    width: 104%;
    height: 110%;
  }

  .pencil--tick {
    top: 0.5rem;
    right: 0.6rem;
    width: 3.4rem;
    height: 3.3rem;
  }

  .pencil__wax {
    fill: var(--pencil);
  }

  .pencil__reveal {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-dasharray: 1;
    animation: pencil-draw 0.9s 0.9s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .pencil--tick .pencil__reveal {
    animation: none;
  }

  @keyframes pencil-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
