---
import '../styles/global.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Thibo Vonderlynck | Web developer and designer',
  description = 'Portfolio of Thibo Vonderlynck, web developer and UX designer and co-founder of Spiromni. Projects, experience and contact.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6ecee" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <Header />
    <main>
      <slot />
    </main>
    <Contact />

  </body>
</html>
